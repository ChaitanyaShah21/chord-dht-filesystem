# ---- Build output: never commit ----
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# ---- Compiled binaries at the repo root (name them here as they appear) ----
/tracker
/client
/node
/lookup
/sim-hops
/test-chord
/test-net
/test-lookup
/test-stabilize
/test-chunk
/test-transfer
/test-names
/client-tsan
/test-transfer-tsan
/chunk
/sim-balance
/node-tsan
/test-raft
/test-replica
/tracker-tsan
/test-replica-tsan

# ---- Test blobs and generated data: large, uninteresting, and they bloat clones ----
# Regenerate deterministically with scripts/make-testdata.sh
*.iso
*.bin
*.dat
*.mp4
*.avi
*.jpg
testdata/
downloads*/

# ---- A local cluster from scripts/cluster.sh: stores, logs, PIDs ----
/cluster/

# ---- Per-port tracker state and any other runtime logs ----
*.log

# ---- Benchmark raw output: the summary belongs in BENCHMARKS.md, the raw dumps do not ----
bench/raw/
bench/work-raft/
*.csv.gz

# ---- Keep the figures. They are the Results section. ----
!docs/figures/*.png
!docs/figures/*.svg

# ---- Language-specific ----
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
target/

# ---- Editors and operating systems ----
.vscode/
.idea/
.DS_Store
*.swp
*:Zone.Identifier

# ---- Secrets. Never. ----
.env
*.pem
*.key
