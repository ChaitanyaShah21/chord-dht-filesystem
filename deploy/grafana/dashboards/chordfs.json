  {
   "id": 11,
   "type": "timeseries",
   "title": "Throughput through the nodes",
   "description": "Chunk bytes received (PUT, STORE) and sent (CHUNK) by every node, summed: the system's throughput whatever the clients' lifetimes (D-085).",
